+  "⏳": [<circle key="c" cx="12" cy="12" r="10" />, P("M12 6v6l4 2")],
+  "💰": [P("M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"), P("M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4")],
